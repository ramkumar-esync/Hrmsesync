APP_NAME="eSync Workspace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite by default so the app runs with no database setup.
# For MySQL, comment this out and use the block below.
DB_CONNECTION=sqlite

# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=payroll_portal
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# Payslip documents are private. Never move this to the "public" disk.
PAYSLIP_DISK=local
PAYSLIP_PATH=payslips

# Payroll
PAYROLL_CURRENCY=MYR
PAYROLL_WORKING_DAYS_PER_MONTH=22

# Statutory engine: malaysia | none
STATUTORY_PROFILE=malaysia
# PCB/MTD engine: manual | progressive_estimate
PCB_ENGINE=manual

# Company details printed on the payslip
COMPANY_NAME="Your Company Sdn Bhd"
COMPANY_REGISTRATION_NUMBER=
COMPANY_ADDRESS=

# Leave
LEAVE_REST_DAYS=saturday,sunday
LEAVE_BACKDATE_GRACE_DAYS=7

# Origins allowed to call the API (the Vue app in development)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
